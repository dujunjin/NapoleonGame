:root {
    --ink: #e8dfcc;
    --muted: #a9a69d;
    --gold: #c5a35c;
    --gold-bright: #eed694;
    --coal: #091016;
    --panel: rgba(17, 26, 35, 0.93);
    --panel-soft: rgba(24, 35, 45, 0.8);
    --france: #234d77;
    --prussia: #273037;
    --russia: #466040;
    --danger: #a5483f;
    --success: #6f9b74;
}

.battle-root {
    flex-grow: 1;
    min-width: 1180px;
    min-height: 680px;
    -unity-font-definition: url("../Fonts/NotoSansCJKsc-Regular SDF.asset");
    color: var(--ink);
    background-color: #0a1219;
    overflow: hidden;
}

.battle-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #17222a;
    opacity: 1;
}

.glass-panel {
    background-color: var(--panel);
    border-top-color: rgba(217, 189, 116, 0.25);
    border-right-color: rgba(217, 189, 116, 0.25);
    border-bottom-color: rgba(217, 189, 116, 0.25);
    border-left-color: rgba(217, 189, 116, 0.25);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-radius: 10px;
}

.top-bar {
    height: 86px;
    margin-top: 12px;
    margin-right: 16px;
    margin-left: 16px;
    padding-right: 14px;
    padding-left: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.identity-cluster {
    width: 310px;
}

.eyebrow {
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.identity-name {
    color: #f1eadb;
    font-size: 18px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.player-identity {
    font-size: 15px;
}

.micro-copy,
.hint-copy,
.dock-hint {
    color: var(--muted);
    font-size: 11px;
}

.turn-cluster {
    align-items: center;
}

.round-label {
    color: var(--gold-bright);
    font-size: 17px;
    -unity-font-style: bold;
}

.frontline-status {
    color: #c2c8c8;
    font-size: 11px;
    margin-top: 3px;
}

.hq-card {
    width: 190px;
    height: 62px;
    padding-top: 7px;
    padding-right: 10px;
    padding-bottom: 7px;
    padding-left: 10px;
    border-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    transition-property: border-color, scale, background-color;
    transition-duration: 140ms;
}

.enemy-hq {
    background-color: #402b2c;
    border-top-color: #b06a62;
    border-right-color: #b06a62;
    border-bottom-color: #b06a62;
    border-left-color: #b06a62;
}

.player-hq {
    background-color: #173654;
    border-top-color: #6288a8;
    border-right-color: #6288a8;
    border-bottom-color: #6288a8;
    border-left-color: #6288a8;
}

.hq-label {
    color: #c9c3b5;
    font-size: 9px;
    letter-spacing: 1px;
}

.hq-health {
    font-size: 20px;
    -unity-font-style: bold;
    position: absolute;
    right: 10px;
    top: 8px;
}

.health-track {
    height: 5px;
    margin-top: 8px;
    border-radius: 3px;
    background-color: rgba(5, 8, 10, 0.66);
    overflow: hidden;
}

.health-fill {
    height: 5px;
    width: 100%;
    transition-property: width, background-color;
    transition-duration: 260ms;
}

.enemy-health-fill {
    background-color: #ba6057;
}

.player-health-fill {
    background-color: #6d9cc7;
}

.main-stage {
    flex-grow: 1;
    min-height: 410px;
    margin-top: 10px;
    margin-right: 16px;
    margin-left: 16px;
    flex-direction: row;
}

.left-rail,
.right-rail {
    width: 214px;
    padding-top: 14px;
    padding-right: 13px;
    padding-bottom: 14px;
    padding-left: 13px;
}

.rail-title {
    color: var(--gold-bright);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.small-title {
    font-size: 11px;
}

.hint-copy {
    margin-top: 8px;
    white-space: normal;
    line-height: 16px;
}

.divider {
    height: 1px;
    margin-top: 11px;
    margin-bottom: 11px;
    background-color: rgba(214, 189, 111, 0.2);
}

.event-log {
    flex-grow: 1;
    margin-top: 8px;
}

.event-entry {
    color: #c5c3bb;
    font-size: 10px;
    white-space: normal;
    border-left-color: #b89b58;
    border-left-width: 2px;
    padding-left: 7px;
    margin-bottom: 7px;
}

.battle-surface {
    flex-grow: 1;
    min-width: 670px;
    margin-right: 10px;
    margin-left: 10px;
    padding-top: 7px;
    padding-right: 8px;
    padding-bottom: 7px;
    padding-left: 8px;
    background-color: rgba(17, 26, 29, 0.62);
    border-radius: 12px;
    border-top-color: rgba(211, 187, 104, 0.25);
    border-right-color: rgba(211, 187, 104, 0.25);
    border-bottom-color: rgba(211, 187, 104, 0.25);
    border-left-color: rgba(211, 187, 104, 0.25);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.zone-block {
    flex-grow: 1;
}

.zone-heading {
    height: 25px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-right: 9px;
    padding-left: 9px;
}

.zone-title {
    color: #aeb4b3;
    font-size: 10px;
    letter-spacing: 1px;
}

.resource-copy {
    font-size: 11px;
    -unity-font-style: bold;
}

.enemy-resource {
    color: #c9857d;
}

.player-resource {
    color: #86b5dd;
}

.slot-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.board-slot {
    width: 124px;
    min-width: 94px;
    max-width: 142px;
    height: 104px;
    margin-right: 4px;
    margin-left: 4px;
    border-radius: 9px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    transition-property: border-color, background-color, scale;
    transition-duration: 120ms;
}

.support-slot {
    background-color: rgba(25, 37, 42, 0.42);
    border-top-color: rgba(125, 145, 151, 0.58);
    border-right-color: rgba(125, 145, 151, 0.58);
    border-bottom-color: rgba(125, 145, 151, 0.58);
    border-left-color: rgba(125, 145, 151, 0.58);
}

.frontline-slot {
    height: 112px;
    background-color: rgba(43, 42, 33, 0.48);
    border-top-color: rgba(198, 168, 91, 0.68);
    border-right-color: rgba(198, 168, 91, 0.68);
    border-bottom-color: rgba(198, 168, 91, 0.68);
    border-left-color: rgba(198, 168, 91, 0.68);
}

.frontline-divider {
    height: 23px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.frontline-rule {
    width: 90px;
    height: 1px;
    background-color: rgba(184, 151, 80, 0.67);
}

.frontline-title {
    color: var(--gold);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-right: 8px;
    margin-left: 8px;
}

.right-rail {
    width: 230px;
}

.inspect-art {
    height: 102px;
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 9px;
    justify-content: flex-end;
    background-color: #30414b;
    border-radius: 7px;
    border-bottom-color: var(--gold);
    border-bottom-width: 2px;
    -unity-background-scale-mode: scale-and-crop;
}

.inspect-type {
    align-self: flex-start;
    color: #f2e3b2;
    font-size: 9px;
    background-color: rgba(8, 12, 15, 0.79);
    padding-top: 3px;
    padding-right: 6px;
    padding-bottom: 3px;
    padding-left: 6px;
    border-radius: 3px;
}

.inspect-title {
    color: #f0e8d7;
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.inspect-stats {
    color: var(--gold-bright);
    font-size: 11px;
    margin-top: 6px;
    white-space: normal;
}

.inspect-rules {
    color: #bab9b4;
    font-size: 10px;
    line-height: 15px;
    margin-top: 8px;
    white-space: normal;
}

.command-button,
.small-button {
    color: #eee7d7;
    background-color: #29333b;
    border-top-color: #88784f;
    border-right-color: #88784f;
    border-bottom-color: #88784f;
    border-left-color: #88784f;
    border-radius: 6px;
    -unity-font-style: bold;
}

.command-button {
    height: 34px;
    margin-top: 6px;
}

.primary-button {
    background-color: #8d3f34;
    border-top-color: #d99070;
    border-right-color: #d99070;
    border-bottom-color: #d99070;
    border-left-color: #d99070;
}

.secondary-button {
    background-color: #314a58;
    border-top-color: #7891a0;
    border-right-color: #7891a0;
    border-bottom-color: #7891a0;
    border-left-color: #7891a0;
}

.command-button:hover,
.small-button:hover {
    border-top-color: var(--gold-bright);
    border-right-color: var(--gold-bright);
    border-bottom-color: var(--gold-bright);
    border-left-color: var(--gold-bright);
    scale: 1.02 1.02;
}

.command-button:disabled,
.small-button:disabled {
    opacity: 0.45;
}

.motion-toggle {
    color: #aaa9a4;
    font-size: 10px;
    margin-top: 8px;
}

.bottom-dock {
    height: 188px;
    margin-top: 10px;
    margin-right: 16px;
    margin-bottom: 12px;
    margin-left: 16px;
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 12px;
    flex-direction: row;
    align-items: center;
}

.bottom-dock .player-hq {
    width: 168px;
    margin-right: 12px;
}

.hand-region {
    flex-grow: 1;
    height: 168px;
}

.hand-heading {
    height: 27px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-right: 8px;
    padding-left: 8px;
}

.hand-scroll {
    flex-grow: 1;
}

.hand-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: flex-end;
    padding-right: 5px;
    padding-left: 5px;
}

.dock-actions {
    width: 112px;
    margin-left: 10px;
    align-items: stretch;
}

.small-button {
    height: 28px;
    font-size: 10px;
}

.dock-hint {
    margin-top: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.hand-card {
    width: 108px;
    height: 136px;
    margin-right: -6px;
    padding: 5px;
    flex-shrink: 0;
    background-color: #e0d3b7;
    color: #171715;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #7d6539;
    border-right-color: #7d6539;
    border-bottom-color: #7d6539;
    border-left-color: #7d6539;
    border-radius: 7px;
    transition-property: translate, scale, opacity, border-color;
    transition-duration: 120ms;
}

.hand-card:hover {
    translate: 0 -12px;
    scale: 1.05 1.05;
    border-top-color: #f3d985;
    border-right-color: #f3d985;
    border-bottom-color: #f3d985;
    border-left-color: #f3d985;
}

.card-selected {
    translate: 0 -13px;
    scale: 1.06 1.06;
    border-top-color: #ffe39b;
    border-right-color: #ffe39b;
    border-bottom-color: #ffe39b;
    border-left-color: #ffe39b;
}

.pressed-source {
    scale: 0.97 0.97;
    border-top-color: #ffe39b;
    border-right-color: #ffe39b;
    border-bottom-color: #ffe39b;
    border-left-color: #ffe39b;
}

.dragging-source {
    opacity: 0.44;
    scale: 0.96 0.96;
}

.card-topline {
    height: 21px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.cost-badge,
.stat-badge {
    min-width: 19px;
    height: 19px;
    border-radius: 10px;
    color: #f7eed8;
    background-color: #263d51;
    -unity-text-align: middle-center;
    font-size: 10px;
    -unity-font-style: bold;
}

.card-name {
    flex-grow: 1;
    margin-right: 3px;
    margin-left: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.card-art {
    height: 57px;
    margin-top: 3px;
    margin-bottom: 3px;
    background-color: #4a5961;
    border-bottom-color: #8b6b36;
    border-bottom-width: 2px;
    -unity-background-scale-mode: scale-and-crop;
}

.card-rule {
    flex-grow: 1;
    color: #34312b;
    font-size: 7px;
    white-space: normal;
    line-height: 9px;
}

.card-stats {
    height: 19px;
    flex-direction: row;
    justify-content: space-between;
}

.attack-badge {
    background-color: #8d3f34;
}

.health-badge {
    background-color: #4e724d;
}

.operation-badge {
    background-color: #584b35;
}

.faction-france .card-art,
.unit-france .unit-art,
.inspect-france {
    background-color: var(--france);
}

.faction-prussia .card-art,
.unit-prussia .unit-art,
.inspect-prussia {
    background-color: var(--prussia);
}

.faction-russia .card-art,
.unit-russia .unit-art,
.inspect-russia {
    background-color: var(--russia);
}

.unit-view {
    flex-grow: 1;
    padding: 5px;
    color: #ece5d4;
    background-color: #1d2b34;
    border-radius: 8px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #7e7257;
    border-right-color: #7e7257;
    border-bottom-color: #7e7257;
    border-left-color: #7e7257;
    transition-property: translate, scale, opacity, rotate, border-color, background-color;
    transition-duration: 150ms;
}

.unit-art {
    height: 37px;
    margin-bottom: 3px;
    justify-content: flex-end;
    padding: 3px;
    -unity-background-scale-mode: scale-and-crop;
}

.unit-type {
    align-self: flex-start;
    color: #e4d8b1;
    background-color: rgba(7, 9, 11, 0.68);
    padding-right: 4px;
    padding-left: 4px;
    font-size: 7px;
}

.unit-name {
    font-size: 9px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.unit-footer {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.unit-keywords {
    flex-grow: 1;
    color: #bab5a9;
    font-size: 7px;
    white-space: normal;
}

.unit-stat {
    min-width: 22px;
    height: 21px;
    border-radius: 11px;
    color: white;
    -unity-text-align: middle-center;
    font-size: 10px;
    -unity-font-style: bold;
    margin-left: 2px;
}

.unit-exhausted {
    opacity: 0.56;
}

.unit-shaken {
    border-top-color: #c86455;
    border-right-color: #c86455;
    border-bottom-color: #c86455;
    border-left-color: #c86455;
    rotate: -1.5deg;
}

.legal-target {
    border-top-color: #f4d070;
    border-right-color: #f4d070;
    border-bottom-color: #f4d070;
    border-left-color: #f4d070;
    background-color: rgba(112, 90, 37, 0.27);
    scale: 1.03 1.03;
}

.legal-target:hover {
    scale: 1.07 1.07;
    background-color: rgba(151, 118, 47, 0.4);
}

.magnet-target {
    scale: 1.1 1.1;
    background-color: rgba(174, 137, 55, 0.52);
    border-top-color: #fff0b2;
    border-right-color: #fff0b2;
    border-bottom-color: #fff0b2;
    border-left-color: #fff0b2;
}

.target-preview-badge {
    position: absolute;
    right: -7px;
    top: -9px;
    min-width: 38px;
    height: 19px;
    padding-right: 6px;
    padding-left: 6px;
    color: #172027;
    background-color: #f3d985;
    border-radius: 10px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.drag-accept {
    scale: 1.14 1.14;
}

.drag-reject {
    translate: 7px 0;
    border-top-color: #d85e50;
    border-right-color: #d85e50;
    border-bottom-color: #d85e50;
    border-left-color: #d85e50;
}

.illegal-source {
    opacity: 0.43;
}

.drag-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.drag-ghost {
    position: absolute;
    width: 104px;
    height: 130px;
    opacity: 0.86;
    scale: 1.08 1.08;
    background-color: #ded1b5;
    border-radius: 7px;
    border-top-color: #ffe39b;
    border-right-color: #ffe39b;
    border-bottom-color: #ffe39b;
    border-left-color: #ffe39b;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    padding: 8px;
    color: #171715;
}

.drag-ghost-title {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.attack-arrow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.damage-pop {
    position: absolute;
    color: #ffdfad;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #541d18;
    transition-property: translate, opacity, scale;
    transition-duration: 340ms;
}

.damage-pop-active {
    translate: 0 -38px;
    opacity: 0;
    scale: 1.35 1.35;
}

.impact-burst {
    position: absolute;
    width: 54px;
    height: 54px;
    opacity: 0.9;
    scale: 0.25 0.25;
    border-radius: 27px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-color: #ffdd83;
    border-right-color: #d96848;
    border-bottom-color: #ffdd83;
    border-left-color: #d96848;
    transition-property: scale, opacity, rotate;
    transition-duration: 240ms;
}

.impact-burst-active {
    scale: 1.75 1.75;
    opacity: 0;
    rotate: 35deg;
}

.no-transition {
    transition-duration: 0ms;
}

.anim-deploy {
    translate: 0 16px;
    opacity: 0;
    scale: 0.82 0.82;
}

.anim-attack {
    scale: 1.12 1.12;
    border-top-color: #f5cf72;
    border-right-color: #f5cf72;
    border-bottom-color: #f5cf72;
    border-left-color: #f5cf72;
}

.anim-hit {
    translate: 4px 0;
    background-color: #73342e;
}

.anim-destroy {
    opacity: 0;
    scale: 0.55 0.55;
    rotate: 8deg;
}

.turn-banner {
    position: absolute;
    width: 360px;
    height: 104px;
    left: 50%;
    top: 44%;
    margin-left: -180px;
    margin-top: -52px;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 18, 24, 0.92);
    border-top-color: var(--gold);
    border-bottom-color: var(--gold);
    border-top-width: 1px;
    border-bottom-width: 1px;
    transition-property: opacity, scale;
    transition-duration: 180ms;
}

.turn-banner-title {
    color: var(--gold-bright);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.turn-banner-subtitle {
    color: #aaa69b;
    font-size: 11px;
    margin-top: 4px;
}

.toast {
    position: absolute;
    left: 50%;
    bottom: 210px;
    width: 420px;
    margin-left: -210px;
    padding-top: 9px;
    padding-right: 14px;
    padding-bottom: 9px;
    padding-left: 14px;
    color: #f4ead7;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: rgba(74, 38, 34, 0.93);
    border-radius: 6px;
    transition-property: opacity, translate;
    transition-duration: 150ms;
}

.hidden-overlay {
    display: none;
}

.modal-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 9, 13, 0.85);
}

.setup-card,
.result-card {
    width: 440px;
    padding-top: 28px;
    padding-right: 32px;
    padding-bottom: 28px;
    padding-left: 32px;
    color: var(--ink);
    background-color: #17212a;
    border-top-color: var(--gold);
    border-right-color: var(--gold);
    border-bottom-color: var(--gold);
    border-left-color: var(--gold);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-radius: 10px;
}

.setup-title,
.result-title {
    color: var(--gold-bright);
    font-size: 28px;
    -unity-font-style: bold;
}

.setup-copy,
.result-copy {
    color: #b5b2aa;
    font-size: 12px;
    white-space: normal;
    margin-top: 7px;
    margin-bottom: 16px;
}

.setup-field {
    margin-top: 8px;
    color: var(--ink);
}

.setup-actions {
    margin-top: 18px;
    flex-direction: row;
    justify-content: flex-end;
}

.setup-actions .small-button {
    width: 90px;
    margin-top: 9px;
    margin-right: 8px;
}

.setup-start {
    width: 130px;
}

.result-card {
    align-items: center;
}

.result-copy {
    -unity-text-align: middle-center;
}

.result-card .command-button {
    width: 190px;
}

.critical-health {
    background-color: #a83b35;
}
